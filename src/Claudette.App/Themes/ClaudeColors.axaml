<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Claudette.App.Themes.ClaudeColors">
  <!-- Settings → Appearance → Style → Claude (DESIGN.md §3, "Visual style"): the Claude apps' ivory and warm greys,
       with Claude's orange as the accent. AppColors copies these over App.axaml's tokens of the same name, and puts
       them back for Standard. Surfaces, text, inline code and the accent change, and cautions (a waiting prompt, a
       usage alert) become warm tints of the accent instead of yellow. Errors, diffs and the charts' model lines keep
       App.axaml's colors. The accent is a fixed color, so these use it directly rather than SystemAccentColor. The
       Claude style's shapes are in App.axaml and TabView.axaml, under the "claude" class. -->
  <ResourceDictionary.ThemeDictionaries>
    <!-- Light, on claude.ai's scale: white cards and composer (#FFFFFF), an ivory page (#FAF9F5), a warmer sidebar
         (#F5F4ED) and selection (#E8E6DC), near-black text (#141413) and warm grey muted text. -->
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="FrameBrush" Color="#F0EEE6" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#73726C" />
      <SolidColorBrush x:Key="DividerBrush" Color="#261F1E1D" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SubtleBrush" Color="#F5F4ED" />
      <SolidColorBrush x:Key="HoverBrush" Color="#0F1F1E1D" />
      <SolidColorBrush x:Key="IslandBrush" Color="#FAF9F5" />
      <SolidColorBrush x:Key="ToolIconSelectedBrush" Color="#D97757" />
      <SolidColorBrush x:Key="ToolIconSelectedTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TabSelectedBrush" Color="#E8E6DC" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#F5F4ED" />
      <!-- The pinned groups' band at the top of the sidebar (DESIGN.md §4, "Pinning a group"): a shade off the sidebar's
           island. In dark, the frame is darker than the island, so the band is a shade lighter, away from it. -->
      <SolidColorBrush x:Key="PinnedGroupsBrush" Color="#F5F4EE" />
      <SolidColorBrush x:Key="ExplorerBrush" Color="#F5F4ED" />
      <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComposerBorderBrush" Color="#261F1E1D" />
      <SolidColorBrush x:Key="DialogBrush" Color="#FAF9F5" />
      <!-- A darker orange for text, readable on ivory and white. -->
      <SolidColorBrush x:Key="AccentStatusBrush" Color="#B5573A" />
      <SolidColorBrush x:Key="SelectedRowBrush" Color="#D97757" Opacity="0.14" />
      <SolidColorBrush x:Key="FindHighlightBrush" Color="#E8A93B" Opacity="0.45" />
      <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A1F1E1D" />
      <SolidColorBrush x:Key="MeterBrush" Color="#D97757" />
      <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#F0EEE6" />
      <!-- The Project Files tab's editor (DESIGN.md §18): changed lines' bars, the selection and the current line in Claude's warm tones. -->
      <SolidColorBrush x:Key="ChangeModifiedBrush" Color="#D97757" />
      <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#0A1F1E1D" />
      <SolidColorBrush x:Key="EditorSelectionBrush" Color="#D97757" Opacity="0.22" />
      <SolidColorBrush x:Key="InlineCodeBrush" Color="#EDEAE0" />
      <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#9E3D25" />
      <!-- Cautions (a waiting prompt, a usage alert) in warm tints of the accent rather than yellow. -->
      <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FBF0EA" />
      <SolidColorBrush x:Key="CautionBorderBrush" Color="#E3A68C" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#9A5418" />
      <!-- The conversation's cards (DESIGN.md §18, "Conversation cards"): your cards warm grey, as the Claude apps' bubbles
           are, Claude's in its orange, and modified files blue, which stays apart from the orange with color blindness
           (checked with the categorical palette's validator). The labels are at least 4.5:1 on their tints. -->
      <SolidColorBrush x:Key="CardYouStripeBrush" Color="#B0AEA5" />
      <SolidColorBrush x:Key="CardYouTintBrush" Color="#73726C" Opacity="0.06" />
      <SolidColorBrush x:Key="CardYouOutlineBrush" Color="#73726C" Opacity="0.2" />
      <SolidColorBrush x:Key="CardYouLabelBrush" Color="#5E5D57" />
      <SolidColorBrush x:Key="CardClaudeStripeBrush" Color="#D97757" />
      <SolidColorBrush x:Key="CardClaudeTintBrush" Color="#D97757" Opacity="0.07" />
      <SolidColorBrush x:Key="CardClaudeOutlineBrush" Color="#D97757" Opacity="0.3" />
      <SolidColorBrush x:Key="CardClaudeLabelBrush" Color="#9E4A30" />
      <SolidColorBrush x:Key="CardFilesStripeBrush" Color="#2A78D6" />
      <SolidColorBrush x:Key="CardFilesTintBrush" Color="#2A78D6" Opacity="0.05" />
      <SolidColorBrush x:Key="CardFilesOutlineBrush" Color="#2A78D6" Opacity="0.28" />
      <SolidColorBrush x:Key="CardFilesLabelBrush" Color="#1F5FAE" />
      <SolidColorBrush x:Key="CardStatsStripeBrush" Color="#7A8291" />
      <SolidColorBrush x:Key="CardStatsTintBrush" Color="#7A8291" Opacity="0.07" />
      <SolidColorBrush x:Key="CardStatsOutlineBrush" Color="#7A8291" Opacity="0.28" />
      <SolidColorBrush x:Key="CardStatsLabelBrush" Color="#5B6372" />
      <SolidColorBrush x:Key="CardNeutralStripeBrush" Color="#C2C0B6" />
      <SolidColorBrush x:Key="CardNeutralTintBrush" Color="#1F1E1D" Opacity="0.03" />
      <SolidColorBrush x:Key="CardNeutralOutlineBrush" Color="#1F1E1D" Opacity="0.1" />
      <SolidColorBrush x:Key="CardNeutralLabelBrush" Color="#63625C" />
      <SolidColorBrush x:Key="CardTileBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardTileBorderBrush" Color="#1F1E1D" Opacity="0.1" />
    </ResourceDictionary>
    <!-- Dark, on the same scale: a charcoal page (#262624), lighter cards and composer (#30302E), a darker sidebar
         (#1F1E1D), off-white text (#FAF9F5) and warm grey muted text. -->
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="FrameBrush" Color="#1F1E1D" />
      <SolidColorBrush x:Key="ChangeModifiedBrush" Color="#D97757" />
      <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#0FFAF9F5" />
      <SolidColorBrush x:Key="EditorSelectionBrush" Color="#D97757" Opacity="0.3" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#9C9A92" />
      <SolidColorBrush x:Key="DividerBrush" Color="#26DEDCD1" />
      <SolidColorBrush x:Key="CardBrush" Color="#30302E" />
      <SolidColorBrush x:Key="SubtleBrush" Color="#1F1E1D" />
      <SolidColorBrush x:Key="HoverBrush" Color="#14FAF9F5" />
      <SolidColorBrush x:Key="IslandBrush" Color="#262624" />
      <SolidColorBrush x:Key="ToolIconSelectedBrush" Color="#D97757" />
      <SolidColorBrush x:Key="ToolIconSelectedTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TabSelectedBrush" Color="#30302E" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#1F1E1D" />
      <SolidColorBrush x:Key="PinnedGroupsBrush" Color="#2A2A28" />
      <!-- The Files tab's explorer: the sidebar's #1F1E1D is the frame's too, so the explorer would read as the frame and
           its divider as a stray line; a shade between the frame and the editor's island (#262624) sets it apart. -->
      <SolidColorBrush x:Key="ExplorerBrush" Color="#232221" />
      <SolidColorBrush x:Key="ComposerBrush" Color="#30302E" />
      <SolidColorBrush x:Key="ComposerBorderBrush" Color="#33DEDCD1" />
      <SolidColorBrush x:Key="DialogBrush" Color="#30302E" />
      <!-- A lighter orange for text, readable on the dark greys. -->
      <SolidColorBrush x:Key="AccentStatusBrush" Color="#E9A48D" />
      <SolidColorBrush x:Key="SelectedRowBrush" Color="#D97757" Opacity="0.22" />
      <SolidColorBrush x:Key="FindHighlightBrush" Color="#F0B95A" Opacity="0.4" />
      <SolidColorBrush x:Key="MeterTrackBrush" Color="#26FAF9F5" />
      <SolidColorBrush x:Key="MeterBrush" Color="#D97757" />
      <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#1F1E1D" />
      <SolidColorBrush x:Key="InlineCodeBrush" Color="#141413" />
      <SolidColorBrush x:Key="InlineCodeTextBrush" Color="#E9A48D" />
      <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#33271F" />
      <SolidColorBrush x:Key="CautionBorderBrush" Color="#80503A" />
      <SolidColorBrush x:Key="WarningTextBrush" Color="#E3B062" />
      <SolidColorBrush x:Key="CardYouStripeBrush" Color="#8A887F" />
      <SolidColorBrush x:Key="CardYouTintBrush" Color="#9C9A92" Opacity="0.08" />
      <SolidColorBrush x:Key="CardYouOutlineBrush" Color="#9C9A92" Opacity="0.25" />
      <SolidColorBrush x:Key="CardYouLabelBrush" Color="#C2C0B6" />
      <SolidColorBrush x:Key="CardClaudeStripeBrush" Color="#D4714F" />
      <SolidColorBrush x:Key="CardClaudeTintBrush" Color="#D4714F" Opacity="0.1" />
      <SolidColorBrush x:Key="CardClaudeOutlineBrush" Color="#D4714F" Opacity="0.38" />
      <SolidColorBrush x:Key="CardClaudeLabelBrush" Color="#E9A48D" />
      <SolidColorBrush x:Key="CardFilesStripeBrush" Color="#3987E5" />
      <SolidColorBrush x:Key="CardFilesTintBrush" Color="#3987E5" Opacity="0.1" />
      <SolidColorBrush x:Key="CardFilesOutlineBrush" Color="#3987E5" Opacity="0.38" />
      <SolidColorBrush x:Key="CardFilesLabelBrush" Color="#8DB8EE" />
      <SolidColorBrush x:Key="CardStatsStripeBrush" Color="#8A909C" />
      <SolidColorBrush x:Key="CardStatsTintBrush" Color="#8A909C" Opacity="0.08" />
      <SolidColorBrush x:Key="CardStatsOutlineBrush" Color="#8A909C" Opacity="0.3" />
      <SolidColorBrush x:Key="CardStatsLabelBrush" Color="#AEB4C0" />
      <SolidColorBrush x:Key="CardNeutralStripeBrush" Color="#6B6A64" />
      <SolidColorBrush x:Key="CardNeutralTintBrush" Color="#FAF9F5" Opacity="0.03" />
      <SolidColorBrush x:Key="CardNeutralOutlineBrush" Color="#DEDCD1" Opacity="0.14" />
      <SolidColorBrush x:Key="CardNeutralLabelBrush" Color="#9C9A92" />
      <SolidColorBrush x:Key="CardTileBrush" Color="#30302E" />
      <SolidColorBrush x:Key="CardTileBorderBrush" Color="#DEDCD1" Opacity="0.12" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

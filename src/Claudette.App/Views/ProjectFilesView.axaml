<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Claudette.App.ViewModels"
             xmlns:views="using:Claudette.App.Views"
             x:Class="Claudette.App.Views.ProjectFilesView"
             x:DataType="vm:ProjectFilesViewModel">
  <!-- A folder group's Project Files tab (DESIGN.md §18, "Project files"): the explorer, on the left or the right, and
       the files open in tabs. Its look is in Themes/ProjectFilesStyles.axaml. -->
  <UserControl.Styles>
    <StyleInclude Source="avares://Claudette/Themes/ConversationStyles.axaml" />
    <StyleInclude Source="avares://Claudette/Themes/ProjectFilesStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- A pane's header, with tabs side by side (DESIGN.md §18, "Split panes") -->
    <Border x:Name="PaneHeader" Classes="paneheader" Classes.focused="{Binding IsSelected}" IsVisible="{Binding IsInSplit}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- Its group's color, as in the sidebar -->
          <Border Classes="panecolor" Background="{Binding PaneColor, Converter={x:Static vm:Converters.ColorBrush}}" />
          <TextBlock Classes="small" FontWeight="SemiBold" Text="{Binding DisplayName}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="flat" Padding="6,4" VerticalAlignment="Center" Command="{Binding ClosePaneCommand}"
                ToolTip.Tip="Close pane: the tab stays open in the sidebar" AutomationProperties.Name="Close pane">
          <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform" />
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <!-- The explorer ("The explorer"); its column is the first or the last, as Settings → Files and diffs says -->
      <Border x:Name="Explorer" Classes="explorer" Classes.right="{Binding IsExplorerOnRight}" Width="{Binding ExplorerWidth}" IsVisible="{Binding IsExplorerShown}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="explorerheader">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
              <TextBlock Classes="explorertitle" Text="{Binding ExplorerTitle}" ToolTip.Tip="{Binding Folder}" />
              <!-- In the selected row's folder ("New files and folders") -->
              <Button Grid.Column="1" Classes="flat" Padding="6,4" Command="{Binding NewFileCommand}" CommandParameter="{Binding SelectedRow}"
                      ToolTip.Tip="New file" AutomationProperties.Name="New file">
                <Path Data="{StaticResource IconToolWrite}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" />
              </Button>
              <Button Grid.Column="2" Classes="flat" Padding="6,4" Command="{Binding StartFindCommand}"
                      ToolTip.Tip="{Binding FindTip}" AutomationProperties.Name="Find a file by name">
                <Path Data="{StaticResource IconToolSearch}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" />
              </Button>
              <Button Grid.Column="3" Classes="flat" Padding="6,4" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse all" AutomationProperties.Name="Collapse all">
                <Path Data="{StaticResource IconCollapseAll}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" />
              </Button>
              <Button Grid.Column="4" Classes="flat" Padding="6,4" ToolTip.Tip="More" AutomationProperties.Name="More explorer actions">
                <!-- On its own 12×12 grid: stretched to fit, the dots would sit at the box's top -->
                <Path Data="{StaticResource IconMore}" Fill="{DynamicResource MutedTextBrush}" Width="12" Height="12" Stretch="None" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" CommandParameter="{Binding SelectedRow}" />
                    <Separator />
                    <!-- Finding in files, in the whole project (§18, "Finding in files") -->
                    <MenuItem Header="Find in files…" Command="{Binding FindInProjectCommand}" />
                    <MenuItem Header="Replace in files…" Command="{Binding ReplaceInProjectCommand}" />
                    <Separator />
                    <MenuItem Header="Show only changed files" ToggleType="CheckBox" IsChecked="{Binding ShowOnlyChanged, Mode=OneWay}" Command="{Binding ToggleShowOnlyChangedCommand}" />
                    <Separator IsVisible="{Binding IsGitRepository}" />
                    <MenuItem Header="Claude's changes" ToggleType="Radio" IsChecked="{Binding AgainstClaudeChanges}" IsVisible="{Binding IsGitRepository}"
                              ToolTip.Tip="Mark what the project's open tabs changed, against before Claude's first change" />
                    <MenuItem Header="Against git HEAD" ToggleType="Radio" IsChecked="{Binding AgainstGitHead}" IsVisible="{Binding IsGitRepository}"
                              ToolTip.Tip="Mark every change since the last commit: yours, commands' and closed tabs' too" />
                    <Separator />
                    <MenuItem Header="{Binding MoveExplorerText}" Command="{Binding MoveExplorerCommand}" />
                    <MenuItem Header="Refresh" Command="{Binding RefreshExplorerCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <!-- Deleting asks first, in place ("Renaming and deleting"): Esc is Cancel -->
          <Border x:Name="DeleteQuestionBox" DockPanel.Dock="Top" Classes="explorerquestion" IsVisible="{Binding IsAskingToDelete}" KeyDown="OnDeleteQuestionKeyDown">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Deleting.Text, FallbackValue=''}" TextWrapping="Wrap" />
              <TextBlock Classes="small error" Text="{Binding Deleting.Problem, FallbackValue=''}" TextWrapping="Wrap" IsVisible="{Binding Deleting.HasProblem, FallbackValue=False}" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button x:Name="ConfirmDeleteButton" Classes="accent" Content="{Binding Deleting.ConfirmText, FallbackValue='Delete'}" Command="{Binding ConfirmDeleteCommand}"
                        IsEnabled="{Binding Deleting.CanConfirm, FallbackValue=False}" />
                <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <!-- Perforce asks first, in place, as deleting does (§18, "Perforce in the Files tab"): Esc is Cancel -->
          <Border x:Name="PerforceQuestionBox" DockPanel.Dock="Top" Classes="explorerquestion" IsVisible="{Binding IsAskingPerforce}" KeyDown="OnPerforceQuestionKeyDown">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding PerforceAsking.Text, FallbackValue=''}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button x:Name="ConfirmPerforceButton" Classes="accent" Content="{Binding PerforceAsking.ConfirmText, FallbackValue=''}" Command="{Binding ConfirmPerforceCommand}"
                        IsEnabled="{Binding PerforceAsking.CanConfirm, FallbackValue=False}" />
                <Button Content="Cancel" Command="{Binding CancelPerforceCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <!-- What p4 refused, until it's dismissed or the next command -->
          <Border DockPanel.Dock="Top" Classes="explorerproblem" IsVisible="{Binding HasPerforceProblem}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="flat" Padding="4" Command="{Binding DismissPerforceProblemCommand}" AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss"
                      VerticalAlignment="Top">
                <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" />
              </Button>
              <SelectableTextBlock Classes="small error" Text="{Binding PerforceProblem}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <!-- The server didn't answer: one quiet line, and no marks -->
          <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="12,6,12,2" Text="{Binding PerforceNote}" TextWrapping="Wrap" IsVisible="{Binding HasPerforceNote}" />
          <!-- Finding a file by name ("Finding a file by name") -->
          <TextBox x:Name="FindBox" DockPanel.Dock="Top" Classes="findfile" Text="{Binding FindText}" IsVisible="{Binding IsFinding}"
                   PlaceholderText="Find a file by name" AutomationProperties.Name="Find a file by name" KeyDown="OnFindKeyDown" />
          <!-- Under them, how many, and what's typed looked for in the files' text instead ("Finding in files") -->
          <Button DockPanel.Dock="Bottom" Classes="findtyped" Command="{Binding FindTypedInFilesCommand}" ToolTip.Tip="{Binding FindTypedInFilesTip}"
                  IsVisible="{Binding IsListingFound}">
            <TextBlock Classes="small" Text="{Binding FindTypedInFilesText}" TextTrimming="CharacterEllipsis" />
          </Button>
          <TextBlock DockPanel.Dock="Bottom" Classes="muted small" Margin="12,4,12,0" Text="{Binding FindSummary}" TextWrapping="Wrap"
                     IsVisible="{Binding IsListingFound}" />
          <Panel>
            <!-- The tree -->
            <ListBox x:Name="TreeList" Classes="explorerlist" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsVisible="{Binding ShowsTree}"
                     AutomationProperties.Name="Project files" KeyDown="OnTreeKeyDown">
              <!-- The empty space under the tree: at the top of the project -->
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="New file" Command="{Binding NewFileCommand}" />
                  <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" />
                  <Separator />
                  <MenuItem Header="Find in files…" Command="{Binding FindInProjectCommand}" />
                  <MenuItem Header="Replace in files…" Command="{Binding ReplaceInProjectCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.DataTemplates>
                <!-- A name typed: a new file's or folder's, at the top of its folder ("New files and folders"), or a new one
                     for a row, in its place ("Renaming and deleting"); before the row's template, which would match it too -->
                <DataTemplate DataType="vm:NameRow">
                  <Grid ColumnDefinitions="Auto,14,Auto,*" RowDefinitions="Auto,Auto" ContextRequested="OnNewRowContextRequested">
                    <Border Width="{Binding Indent}" />
                    <Panel Grid.Column="2" Margin="0,0,6,0">
                      <Path Classes="rowicon" Data="{StaticResource IconToolFolder}" IsVisible="{Binding IsFolderName}" />
                      <Path Classes="rowicon" Data="{StaticResource IconToolRead}" IsVisible="{Binding IsFileName}" />
                    </Panel>
                    <TextBox Grid.Column="3" Classes="newentry" Text="{Binding NameText}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Placeholder}"
                             KeyDown="OnNewRowKeyDown" LostFocus="OnNewRowLostFocus" AttachedToVisualTree="OnNewRowAttached" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="small error newentryproblem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:ExplorerRow">
                  <Panel Classes="explorerrow" Classes.ignored="{Binding IsIgnored}" Background="Transparent" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="700"
                         Tapped="OnRowTapped" DoubleTapped="OnRowDoubleTapped">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                      <Panel DockPanel.Dock="Left" Width="14">
                        <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform"
                              IsVisible="{Binding IsCollapsedFolder}" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" Width="8" Height="8" Stretch="Uniform"
                              IsVisible="{Binding IsExpanded}" VerticalAlignment="Center" />
                      </Panel>
                      <Panel DockPanel.Dock="Left" Margin="0,0,6,0">
                        <Path Classes="rowicon" Data="{StaticResource IconToolFolder}" IsVisible="{Binding IsFolder}" />
                        <Path Classes="rowicon" Data="{StaticResource IconToolRead}" IsVisible="{Binding IsFile}" />
                      </Panel>
                      <TextBlock DockPanel.Dock="Right" Classes="changeletter" Classes.added="{Binding ChangeLetter, Converter={x:Static vm:Converters.IsAddedLetter}}"
                                 Classes.reviewed="{Binding IsReviewed}" Text="{Binding ChangeLetter}" IsVisible="{Binding HasChangeLetter}" />
                      <Ellipse DockPanel.Dock="Right" Classes="changedinside" IsVisible="{Binding HasChangesInside}" />
                      <!-- Its Perforce state, in Perforce's words (§18, "The state in the tree") -->
                      <TextBlock DockPanel.Dock="Right" Classes="p4mark" Text="{Binding PerforceMark}" IsVisible="{Binding HasPerforceMark}"
                                 ToolTip.Tip="{Binding PerforceTip}" AutomationProperties.Name="{Binding PerforceTip}" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <Panel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).OpenRowToStayCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding IsFile}" />
                        <MenuItem Header="Open in the OS's app" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).OpenRowInSystemCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding IsFile}" />
                        <MenuItem Header="Open diff" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).OpenRowDiffCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding HasChangeLetter}" />
                        <Separator IsVisible="{Binding IsFile}" />
                        <MenuItem Header="New file" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).NewFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <MenuItem Header="New folder" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).NewFolderCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Copy path" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).CopyRowPathCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Copy relative path" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).CopyRowRelativePathCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Reveal in file manager" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).RevealRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Collapse" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).ToggleRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding IsExpanded}" />
                        <!-- Perforce, in a workspace (§18, "The Perforce menu") -->
                        <Separator IsVisible="{Binding InPerforce}" />
                        <MenuItem Header="Check out" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).CheckOutRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanCheckOut}" />
                        <MenuItem Header="Mark for add" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).MarkRowForAddCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanMarkForAdd}" />
                        <MenuItem Header="Mark for delete" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).MarkRowForDeleteCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanMarkForDelete}" />
                        <MenuItem Header="Revert" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).RevertRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanRevert}" />
                        <MenuItem Header="Diff against the depot" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).DiffRowAgainstDepotCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanDiffAgainstDepot}" />
                        <!-- Finding in files, in this folder (§18, "Finding in files") -->
                        <Separator IsVisible="{Binding IsFolder}" />
                        <MenuItem Header="Find in folder…" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).FindInFolderCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding IsFolder}" />
                        <MenuItem Header="Replace in folder…" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).ReplaceInFolderCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding IsFolder}" />
                        <Separator />
                        <MenuItem Header="Rename" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).RenameRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Delete" Command="{Binding $parent[ListBox].((vm:ProjectFilesViewModel)DataContext).DeleteRowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Panel.ContextMenu>
                  </Panel>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
            <!-- Show only changed files -->
            <Panel IsVisible="{Binding ShowsChangedList}">
              <TextBlock Classes="muted small" Margin="12,8" Text="Nothing has changed." TextWrapping="Wrap" IsVisible="{Binding HasNoChanges}" />
              <ListBox x:Name="ChangedList" Classes="explorerlist" ItemsSource="{Binding ChangedRows}" AutomationProperties.Name="Changed files" KeyDown="OnTreeKeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:ExplorerRow">
                    <Panel Classes="explorerrow" Background="Transparent" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="700" Tapped="OnRowTapped" DoubleTapped="OnRowDoubleTapped">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="changeletter" Classes.added="{Binding ChangeLetter, Converter={x:Static vm:Converters.IsAddedLetter}}"
                                   Classes.reviewed="{Binding IsReviewed}" Text="{Binding ChangeLetter}" IsVisible="{Binding HasChangeLetter}" />
                        <TextBlock Text="{Binding Name}" Classes.deleted="{Binding IsDeleted}" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
                        <TextBlock Classes="muted small" Text="{Binding FolderText}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding HasFolderText}" />
                      </DockPanel>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
            <!-- Files found by name, best first, each with its folder beside it -->
            <ListBox x:Name="FoundList" Classes="explorerlist" ItemsSource="{Binding Found}" SelectedItem="{Binding SelectedFound}" IsVisible="{Binding IsListingFound}"
                     AutomationProperties.Name="Files found by name">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:FoundFile">
                  <DockPanel Background="Transparent" ToolTip.Tip="{Binding RelativePath}" ToolTip.ShowDelay="700" Tapped="OnFoundTapped">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding NameParts}" VerticalAlignment="Center" Margin="0,0,8,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:NamePart">
                          <TextBlock Text="{Binding Text}" FontWeight="{Binding IsMatch, Converter={x:Static vm:Converters.BoldIfTrue}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted small" Text="{Binding Folder}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding HasFolder}" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>
      <!-- Drag the explorer's edge to resize it; double-click for the default width -->
      <Border x:Name="ExplorerEdge" Width="6" Background="Transparent" Cursor="SizeWestEast" ZIndex="1" IsVisible="{Binding IsExplorerShown}" />

      <!-- The files: their tabs, the question before files close, and the one showing -->
      <DockPanel x:Name="Files" Grid.Column="1">
        <Border DockPanel.Dock="Top" Classes="filetabs">
          <DockPanel>
            <Button DockPanel.Dock="Left" Classes="flat" Padding="9,0" VerticalAlignment="Stretch" Command="{Binding ToggleExplorerCommand}"
                    ToolTip.Tip="{Binding ToggleExplorerText}" AutomationProperties.Name="{Binding ToggleExplorerText}">
              <Path Data="{StaticResource IconSidebar}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
            </Button>
            <Button DockPanel.Dock="Right" Classes="flat rowaction" ToolTip.Tip="Every open file" AutomationProperties.Name="Every open file"
                    IsVisible="{Binding !!OpenFiles.Count}">
              <!-- On its own 12×12 grid: stretched to fit, the dots would sit at the box's top -->
              <Path Classes="filled" Data="{StaticResource IconMore}" />
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding OpenFiles}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ProjectFileViewModel">
                      <Setter Property="Header" Value="{Binding TabLabel}" />
                      <Setter Property="ToggleType" Value="Radio" />
                      <Setter Property="IsChecked" Value="{Binding IsShowing, Mode=OneWay}" />
                      <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).ShowFileCommand, FallbackValue={x:Null}}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- The file showing, in a window of its own ("A file in a window of its own") -->
            <Button x:Name="OpenInWindowButton" DockPanel.Dock="Right" Classes="flat rowaction" Command="{Binding OpenShowingInWindowCommand}"
                    ToolTip.Tip="{Binding OpenInWindowTip}" AutomationProperties.Name="Open in a window" IsVisible="{Binding HasShowing}">
              <Path Classes="stroked" Data="{StaticResource IconOpenWindow}" />
            </Button>
            <ScrollViewer x:Name="TabsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="FileTabs" ItemsSource="{Binding OpenFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ProjectFileViewModel">
                    <Button Classes="flat filetab" Classes.showing="{Binding IsShowing}" Classes.preview="{Binding IsPreview}" Classes.modified="{Binding IsModified}"
                            Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).ShowFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="700" DoubleTapped="OnFileTabDoubleTapped" PointerReleased="OnFileTabPointerReleased"
                            AutomationProperties.Name="{Binding TabLabel}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="{StaticResource IconPin}" Fill="{DynamicResource MutedTextBrush}" Width="7" Height="9" Stretch="Uniform" IsVisible="{Binding IsPinned}" VerticalAlignment="Center" />
                        <TextBlock Classes="tablabel" Text="{Binding TabLabel}" />
                        <Path Classes="inwindow" Data="{StaticResource IconOpenWindow}" IsVisible="{Binding IsInWindow}"
                              ToolTip.Tip="In a window of its own" AutomationProperties.Name="In a window of its own" />
                        <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkTextBrush}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform"
                              IsVisible="{Binding IsReviewed}" VerticalAlignment="Center" ToolTip.Tip="Reviewed" />
                        <Panel Width="18" VerticalAlignment="Center">
                          <Ellipse Classes="unsaved" ToolTip.Tip="Unsaved edits" />
                          <Button Classes="flat closefile" Padding="4" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseFileCommand, FallbackValue={x:Null}}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Close" AutomationProperties.Name="Close the file">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform" />
                          </Button>
                        </Panel>
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Close" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Close others" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseOtherFilesCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Close to the right" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseFilesToTheRightCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Close saved" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseSavedFilesCommand, FallbackValue={x:Null}}" />
                          <MenuItem Header="Close all" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CloseAllFilesCommand, FallbackValue={x:Null}}" />
                          <Separator />
                          <MenuItem Header="{Binding PinMenuText}" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).TogglePinFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="{Binding WindowMenuText}" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).ToggleFileWindowCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Reviewed" ToggleType="CheckBox" IsChecked="{Binding IsReviewed, Mode=OneWay}" IsVisible="{Binding CanReview}"
                                    Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).ToggleFileReviewedCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Copy path" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CopyFilePathCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Copy relative path" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CopyFileRelativePathCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Reveal in the explorer" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).RevealRowInTreeCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Reveal in file manager" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).RevealFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <MenuItem Header="Open in the OS's app" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).OpenFileInSystemCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                          <!-- Perforce, in a workspace (§18, "The Perforce menu") -->
                          <Separator IsVisible="{Binding InPerforce}" />
                          <MenuItem Header="Check out" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).CheckOutFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanCheckOut}" />
                          <MenuItem Header="Mark for add" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).MarkFileForAddCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanMarkForAdd}" />
                          <MenuItem Header="Mark for delete" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).MarkFileForDeleteCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanMarkForDelete}" />
                          <MenuItem Header="Revert" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).RevertFileCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanRevert}" />
                          <MenuItem Header="Diff against the depot" Command="{Binding $parent[UserControl].((vm:ProjectFilesViewModel)DataContext).DiffFileAgainstDepotCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" IsVisible="{Binding CanDiffAgainstDepot}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <!-- Closing files with unsaved edits asks first, in place ("Saving") -->
        <Border DockPanel.Dock="Top" Classes="filebanner" IsVisible="{Binding IsAskingToClose}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
              <Button Classes="accent" Content="{Binding Closing.SaveText, FallbackValue='Save'}" Command="{Binding SaveAndCloseCommand}" />
              <Button Content="Don't save" Command="{Binding CloseWithoutSavingCommand}" />
              <Button Content="Cancel" Command="{Binding CancelCloseCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Closing.Text, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Panel>
          <!-- With nothing open: what to do next, each with its shortcut as it's bound now, as Rider's empty editor has it -->
          <StackPanel Classes="nofile" IsVisible="{Binding !HasShowing}">
            <TextBlock Classes="muted" Text="{Binding NoFileText}" HorizontalAlignment="Center" />
            <Grid x:Name="NoFileActions" Classes="nofileactions" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <Button Content="Go to file" Command="{Binding StartFindCommand}" />
              <TextBlock Grid.Column="1" Classes="keys" Text="{Binding Tips.GoToFileKeys}" />
              <Button Grid.Row="1" Content="Find in files" Command="{Binding FindInProjectCommand}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="keys" Text="{Binding Tips.FindInFilesKeys}" />
              <Button Grid.Row="2" Content="Replace in files" Command="{Binding ReplaceInProjectCommand}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="keys" Text="{Binding Tips.ReplaceInFilesKeys}" />
              <Button Grid.Row="3" Content="Command palette" Command="{Binding OpenPaletteCommand}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="keys" Text="{Binding Tips.CommandPaletteKeys}" />
            </Grid>
          </StackPanel>
          <ItemsControl x:Name="OpenFileViews" ItemsSource="{Binding OpenFiles}">
            <ItemsControl.Styles>
              <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:ProjectFileViewModel">
                <Setter Property="IsVisible" Value="{Binding IsShowing}" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Panel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <!-- Nothing while the file is in a window of its own, whose view has it then -->
              <DataTemplate DataType="vm:ProjectFileViewModel">
                <views:ProjectFileView DataContext="{Binding InTab}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>

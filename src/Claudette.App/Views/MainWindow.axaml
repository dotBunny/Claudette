<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Claudette.App.ViewModels"
        xmlns:controls="using:Claudette.App.Controls"
        xmlns:settings="using:Claudette.Core.Settings"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Claudette.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Claudette"
        Icon="/Assets/claudette.ico"
        Width="1100" Height="800"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FrameBrush}"
        ExtendClientAreaToDecorationsHint="{Binding MergesTitleBar}" Classes.merged="{Binding MergesTitleBar}">
  <Window.Styles>
    <Style Selector="ProgressBar.meter">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource MeterTrackBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MeterBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter.warning">
      <Setter Property="Foreground" Value="{DynamicResource MeterWarningBrush}" />
    </Style>
    <Style Selector="ProgressBar.meter.critical">
      <Setter Property="Foreground" Value="{DynamicResource MeterCriticalBrush}" />
    </Style>
    <Style Selector=":is(Button).header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector=":is(Button).header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- The header's cup (DESIGN.md §9, "Keeping the computer awake"): a switch that stays flat when it's on. The cup
         takes the accent while the setting is on, and steams while the computer is kept awake. -->
    <Style Selector="ToggleButton.header:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.header:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <!-- Disabled where the computer can't be kept awake: just the muted cup, not Fluent's grey pill -->
    <Style Selector="ToggleButton.header:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.keepawake Path">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.keepawake:checked Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentStatusBrush}" />
    </Style>
    <!-- The detailed header's charts (DESIGN.md §6, "Detailed header") -->
    <Style Selector="controls|UsageDetailChart">
      <Setter Property="LineBrush" Value="{DynamicResource MeterBrush}" />
      <Setter Property="ProjectionBrush" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="WarnBrush" Value="{DynamicResource MeterWarningBrush}" />
      <Setter Property="CriticalBrush" Value="{DynamicResource MeterCriticalBrush}" />
      <Setter Property="GridBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="LabelBrush" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="SurfaceBrush" Value="{DynamicResource ChartSurfaceBrush}" />
      <Setter Property="SeriesBrush" Value="{DynamicResource ChartModelBrush}" />
      <Setter Property="Series2Brush" Value="{DynamicResource ChartModel2Brush}" />
    </Style>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="3" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource MeterBrush}" />
    </Style>
    <Style Selector="Border.swatch.model1">
      <Setter Property="Background" Value="{DynamicResource ChartModelBrush}" />
    </Style>
    <Style Selector="Border.swatch.model2">
      <Setter Property="Background" Value="{DynamicResource ChartModel2Brush}" />
    </Style>
    <Style Selector="TextBlock.figure">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Claude's service status (DESIGN.md §18, "Service status"): grey until it's known, then green, amber for
         degraded or maintenance, and red for an outage. -->
    <Style Selector="Ellipse.statusdot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Ellipse.statusdot.operational">
      <Setter Property="Fill" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector="Ellipse.statusdot.degraded">
      <Setter Property="Fill" Value="{DynamicResource MeterWarningBrush}" />
    </Style>
    <Style Selector="Ellipse.statusdot.outage">
      <Setter Property="Fill" Value="{DynamicResource MeterCriticalBrush}" />
    </Style>
    <!-- Its banner: a caution while Claude has problems, and quieter while maintenance is all there is. -->
    <Style Selector="Border.statusbanner">
      <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CautionBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style Selector="Border.statusbanner.info">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <!-- The menu and Settings (DESIGN.md §3): squares as big as the strip's icons -->
    <Style Selector="Button#SettingsButton, Button#MainMenu">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Under the system's title bar, Settings is over the strip: as far in from the window's edge as its icons, 5 pixels,
         past the header's padding of 10. With the header as the title bar, the window's buttons are there. -->
    <Style Selector="Window:not(.merged) Button#SettingsButton">
      <Setter Property="Margin" Value="0,0,-5,0" />
    </Style>
    <!-- The menu's own look (DESIGN.md §3): small muted titles over its sections, an icon before each entry, and lines
         between the sections from edge to edge -->
    <Style Selector="MenuFlyoutPresenter.mainmenu">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinWidth" Value="220" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.mainmenu Separator">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="MenuItem.menusection">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,4,12,2" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="MenuItem.menusection /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="MenuItem.menusection:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Path.menuicon">
      <Setter Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="MaxWidth" Value="14" />
      <Setter Property="MaxHeight" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The header as the window's title bar (DESIGN.md §3, "Window frame"): its gaps drag the window, so each of its
         controls says it takes its own clicks, and the meters and totals their hover, for their tips -->
    <Style Selector="Border#Header :is(Button), Border#Header TextBlock#ProcessTotals">
      <Setter Property="(chrome:WindowDecorationProperties.ElementRole)" Value="User" />
    </Style>
    <!-- The window's buttons as Rider's: as tall as the title bar, so their highlight is too, and side by side, as Windows'
         own are; no title beside the logo, and no full-screen button -->
    <Style Selector="WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button">
      <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>

  <!-- Settings → Appearance → Zoom and Ctrl/Cmd +, −, 0 scale everything inside (DESIGN.md §3, "Accessibility") -->
  <LayoutTransformControl x:Name="Zoomed">
    <Grid>
      <DockPanel>
        <!-- Header: usage meters (DESIGN.md §6) and the account; the window's title bar, unless the system's is used
             (DESIGN.md §3, "Window frame"), when MainWindow.axaml.cs keeps it clear of the window's buttons -->
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="10,6">
          <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <!-- Claudette's logo, as the title bar's, then the menu (DESIGN.md §3): the user guide first, then the rest of Help -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
              <!-- The window's icon on Windows, with room around it as a title bar's icon has (MainWindow.axaml.cs) -->
              <Border x:Name="HeaderIcon" Background="Transparent" Padding="6" Margin="-2,-6,-4,-6" VerticalAlignment="Center"
                      IsVisible="{Binding MergesTitleBar}">
                <Image x:Name="HeaderLogo" Source="/Assets/claudette.ico" AutomationProperties.Name="Claudette" Width="18" Height="18"
                       IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality" />
              </Border>
              <Button Name="MainMenu" Classes="flat" VerticalAlignment="Center" ToolTip.Tip="Menu" AutomationProperties.Name="Menu"
                      IsVisible="{Binding Shell, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <Path Data="{StaticResource IconMenu}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" StrokeLineCap="Round" Stretch="Uniform"
                      MaxWidth="13" MaxHeight="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="mainmenu">
                    <MenuItem Classes="menusection" Header="Help" IsEnabled="False" />
                    <MenuItem Header="User Guide" Command="{Binding Shell.OpenGuideCommand, FallbackValue={x:Null}}">
                      <MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource IconGuide}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Ask on Discord" Command="{Binding Shell.OpenDiscordCommand, FallbackValue={x:Null}}">
                      <MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource IconChat}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Report an issue" Command="{Binding Shell.ReportIssueCommand, FallbackValue={x:Null}}">
                      <MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource IconBug}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Classes="menusection" Header="Claudette" IsEnabled="False" />
                    <MenuItem Header="About Claudette" Command="{Binding Shell.OpenAboutCommand, FallbackValue={x:Null}}">
                      <MenuItem.Icon><Path Classes="menuicon" Data="{StaticResource IconInfo}" /></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Claudette" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"
                       IsVisible="{Binding ShowsHeaderTitle}" />

            <!-- The selected tab runs under an API key: its estimated spend in place of the plan's meters (DESIGN.md §4,
                 "Accounts"). Click for the Usage panel. -->
            <Button x:Name="AccountSpend" Grid.Column="1" Classes="header" HorizontalAlignment="Left" IsVisible="{Binding ShowsSpend}" Command="{Binding Usage.OpenPanelCommand, FallbackValue={x:Null}}"
                    ToolTip.Tip="{Binding Spend.Tooltip, FallbackValue={x:Null}}" AutomationProperties.Name="Estimated API spend">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{Binding Spend.Tag.Brush, FallbackValue={x:Null}}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Spend.Account.Name, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="muted small" Text="API key, estimated" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="muted small" Text="Today" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Spend.TodayText, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="muted small" Text="This week" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Spend.WeekText, FallbackValue=''}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="muted small" Text="This month" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Spend.MonthText, FallbackValue=''}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Button>

            <!-- Click anywhere on the meters for the Usage panel -->
            <Button Grid.Column="1" Classes="header" HorizontalAlignment="Left" IsVisible="{Binding HasUsage}" Command="{Binding Usage.OpenPanelCommand}"
                    ToolTip.Tip="Click for usage details" AutomationProperties.Name="Usage details">
              <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                <!-- Session, the most prominent -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Usage.Session.Tooltip}">
                  <TextBlock Text="Session" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ProgressBar Classes="meter" Width="160" Value="{Binding Usage.Session.Percent}"
                               Classes.warning="{Binding Usage.Session.IsWarning}" Classes.critical="{Binding Usage.Session.IsCritical}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Usage.Session.PercentText}" FontWeight="SemiBold" VerticalAlignment="Center"
                             Classes.warning="{Binding Usage.Session.IsWarning}" Classes.error="{Binding Usage.Session.IsCritical}" />
                  <TextBlock Classes="muted small" Text="{Binding Usage.Session.ResetText}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- The sparkline, as tall as the meter and the projection line together -->
                <controls:UsageChart Name="Sparkline" Grid.RowSpan="2" Grid.Column="1" Width="120"
                                     Points="{Binding Usage.SessionPoints}" Projection="{Binding Usage.SessionProjection}"
                                     RangeStart="{Binding Usage.WindowStart}" RangeEnd="{Binding Usage.WindowEnd}"
                                     WarnLevel="{Binding Usage.WarnPercent}" CriticalLevel="{Binding Usage.CriticalPercent}"
                                     LineBrush="{DynamicResource MeterBrush}" ProjectionBrush="{DynamicResource MutedTextBrush}"
                                     WarnBrush="{DynamicResource MeterWarningBrush}" CriticalBrush="{DynamicResource MeterCriticalBrush}" />

                <!-- Weekly limits, smaller: stacked, the limit across all models on top -->
                <ItemsControl Name="WeeklyMeters" Grid.RowSpan="2" Grid.Column="2" ItemsSource="{Binding Usage.Weekly}" VerticalAlignment="Center"
                              Grid.IsSharedSizeScope="True">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:MeterViewModel">
                      <!-- The labels share a width, right-aligned, so stacked meters' bars line up -->
                      <Grid ColumnSpacing="6" HorizontalAlignment="Left" ToolTip.Tip="{Binding Tooltip}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="WeeklyLabel" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="muted small" Text="{Binding Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Classes="meter" Width="60" Value="{Binding Percent}"
                                     Classes.warning="{Binding IsWarning}" Classes.critical="{Binding IsCritical}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="small" Text="{Binding PercentText}" VerticalAlignment="Center"
                                   Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsCritical}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The plain-language projection, under the session meter -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                  <TextBlock Classes="small muted" Classes.warning="{Binding Usage.IsProjectionWarning}" Text="{Binding Usage.ProjectionText}" />
                  <TextBlock Classes="small muted" Text="{Binding Usage.AsOfText}" IsVisible="{Binding Usage.AsOfText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </Grid>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="muted small" Text="{Binding UsageNote}" VerticalAlignment="Center"
                         IsVisible="{Binding UsageNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <!-- Draws the header taller with charts, and back (DESIGN.md §6, "Detailed header") -->
              <Button Name="UsageDetailsToggle" Classes="flat" Padding="8" VerticalAlignment="Center" IsVisible="{Binding HasUsage}"
                      Command="{Binding Usage.ToggleDetailsCommand, FallbackValue={x:Null}}"
                      ToolTip.Tip="{Binding Usage.DetailsToggleText, FallbackValue=''}" AutomationProperties.Name="{Binding Usage.DetailsToggleText, FallbackValue=''}">
                <Panel Width="12" Height="12">
                  <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Stretch="Uniform"
                        Width="11" Height="6" IsVisible="{Binding !Usage.IsDetailed, FallbackValue=True}" />
                  <Path Data="{StaticResource IconChevronUp}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" Stretch="Uniform"
                        Width="11" Height="6" IsVisible="{Binding Usage.IsDetailed, FallbackValue=False}" />
                </Panel>
              </Button>
              <!-- Every tab's processes together, Claude Code included, while the process monitor is on (DESIGN.md §4,
                   "Process monitor"): each tab's part in the tooltip -->
              <TextBlock Name="ProcessTotals" Classes="muted small" VerticalAlignment="Center" Margin="0,0,4,0"
                         Text="{Binding Shell.ProcessTotalsText, FallbackValue={x:Null}}" ToolTip.Tip="{Binding Shell.ProcessTotalsTip, FallbackValue={x:Null}}"
                         IsVisible="{Binding Shell.ProcessTotalsText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
              <!-- Keeping the computer awake (DESIGN.md §9): the switch for Settings → General's Keep this computer awake,
                   with when in its menu. The cup steams while sleep is held off, for whatever reason, which the tip says. -->
              <ToggleButton Name="KeepAwakeToggle" Classes="header keepawake" Padding="8" VerticalAlignment="Center"
                            IsChecked="{Binding KeepAwake.IsOn}" IsEnabled="{Binding KeepAwake.IsAvailable}"
                            ToolTip.Tip="{Binding KeepAwake.Tooltip}" AutomationProperties.Name="{Binding KeepAwake.AccessibleName}">
                <Panel Width="12" Height="12">
                  <Path Data="{StaticResource IconCup}" StrokeThickness="1.3" StrokeJoin="Round" Stretch="None" />
                  <Path Name="KeepAwakeSteam" Data="{StaticResource IconSteam}" StrokeThickness="1.1" StrokeLineCap="Round" Stretch="None"
                        IsVisible="{Binding KeepAwake.IsKeepingAwake}" />
                </Panel>
                <ToggleButton.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Only while Claude has work to finish" ToggleType="Radio" IsChecked="{Binding KeepAwake.WhileClaudeHasWork, Mode=OneWay}"
                              Command="{Binding KeepAwake.ChooseCommand}" CommandParameter="{x:Static settings:KeepAwakeWhen.ClaudeHasWork}" />
                    <MenuItem Header="Whenever Claudette is running" ToggleType="Radio" IsChecked="{Binding KeepAwake.WhileClaudetteRuns, Mode=OneWay}"
                              Command="{Binding KeepAwake.ChooseCommand}" CommandParameter="{x:Static settings:KeepAwakeWhen.ClaudetteRuns}" />
                    <Separator />
                    <!-- Settings → General, at keeping the computer awake (DESIGN.md §14) -->
                    <MenuItem Header="Keep-awake settings…" Command="{Binding Shell.OpenSettingCommand, FallbackValue={x:Null}}" CommandParameter="General#keepAwake" />
                  </ContextMenu>
                </ToggleButton.ContextMenu>
              </ToggleButton>
              <!-- Claude's service status (DESIGN.md §18, "Service status"): each watched service in the tooltip, and a
                   click opens status.claude.com -->
              <Button Name="ServiceStatusDot" Classes="header" Padding="8" VerticalAlignment="Center" IsVisible="{Binding ServiceStatus.IsVisible}"
                      Command="{Binding ServiceStatus.OpenStatusPageCommand}"
                      ToolTip.Tip="{Binding ServiceStatus.Tooltip}" AutomationProperties.Name="{Binding ServiceStatus.AccessibleName}">
                <Ellipse Classes="statusdot" Classes.operational="{Binding ServiceStatus.IsOperational}"
                         Classes.degraded="{Binding ServiceStatus.IsDegraded}" Classes.outage="{Binding ServiceStatus.IsOutage}" />
              </Button>
              <!-- The account menu (DESIGN.md §11): the email and plan from claude auth status, and Sign out -->
              <Button Classes="header" IsVisible="{Binding Account.Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="Your Claude Code account" AutomationProperties.Name="Account">
                <TextBlock Classes="muted" Text="{Binding Account.HeaderName}" VerticalAlignment="Center" />
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="10" Width="300" Margin="4" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
                      <StackPanel Spacing="2" IsVisible="{Binding IsSignedIn}">
                        <TextBlock Classes="muted small" Text="Signed in to Claude Code as" />
                        <TextBlock Text="{Binding Email, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   IsVisible="{Binding Email, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding PlanText, FallbackValue=''}" TextWrapping="Wrap"
                                   IsVisible="{Binding PlanText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="muted small" Text="{Binding Organization, FallbackValue=''}" TextWrapping="Wrap"
                                   IsVisible="{Binding Organization, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <TextBlock Text="Claude Code isn't signed in." IsVisible="{Binding IsSignedOut}" />
                      <TextBlock Classes="error small" Text="{Binding SignOutError}" TextWrapping="Wrap" IsVisible="{Binding HasSignOutError}" />
                      <Button Classes="flat" Content="{Binding BillingText}" Command="{Binding OpenBillingCommand}" IsVisible="{Binding HasBilling}"
                              ToolTip.Tip="{Binding BillingTip}" HorizontalAlignment="Left" Padding="0,2" />
                      <Button Content="Sign out…" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Left" />
                      <Button Classes="accent" Content="Sign in" Command="{Binding BeginSignInCommand}" IsVisible="{Binding CanBeginSignIn}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <!-- The plan beside the email opens its usage on claude.ai, or the Console's billing (DESIGN.md §11) -->
              <Button Classes="header" Command="{Binding Account.OpenHeaderPlanCommand}" IsVisible="{Binding Account.HeaderPlan, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{Binding Account.HeaderPlanTip}" AutomationProperties.Name="{Binding Account.HeaderPlanName}">
                <TextBlock Classes="muted" Text="{Binding Account.HeaderPlan}" VerticalAlignment="Center" />
              </Button>
              <!-- Settings (DESIGN.md §14) -->
              <Button Name="SettingsButton" Classes="flat" VerticalAlignment="Center" AutomationProperties.Name="Settings"
                      ToolTip.Tip="{Binding Shell.Tips.Settings, FallbackValue=Settings}" Command="{Binding Shell.OpenSettingsCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding Shell, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.4" StrokeLineCap="Round" Stretch="Uniform"
                      MaxWidth="13" MaxHeight="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>

            <!-- The detailed header (DESIGN.md §6): charts of the session and the week, the burn rate and the busiest
                 tabs. Narrow windows leave out the busiest tabs, then the weekly chart. Click for the Usage panel. -->
            <Button Name="UsageDetails" Grid.Row="1" Grid.ColumnSpan="3" Classes="header" Margin="0,6,0,2" HorizontalAlignment="Stretch"
                    IsVisible="{Binding ShowsUsageDetails}" Command="{Binding Usage.OpenPanelCommand, FallbackValue={x:Null}}"
                    ToolTip.Tip="Click for usage details" AutomationProperties.Name="Usage charts">
              <Grid Height="150" ColumnDefinitions="3*,2*,Auto,Auto">
                <!-- The session: usage from the window's start to its reset -->
                <DockPanel Grid.ColumnSpan="{Binding Usage.SessionChartSpan, FallbackValue=1}" Margin="0,0,20,0">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,2">
                    <TextBlock Classes="small" FontWeight="SemiBold" Text="This session" />
                    <TextBlock Grid.Column="1" Classes="small warning" Text="{Binding Usage.CrossingText, FallbackValue=''}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding Usage.HasCrossing, FallbackValue=False}" />
                  </Grid>
                  <controls:UsageDetailChart Name="SessionChart" Axis="Times"
                                             Points="{Binding Usage.DetailSessionPoints}" Projection="{Binding Usage.SessionProjection}"
                                             RangeStart="{Binding Usage.WindowStart}" RangeEnd="{Binding Usage.WindowEnd}"
                                             Now="{Binding Usage.Now}" Marker="{Binding Usage.SessionCrossing}"
                                             WarnLevel="{Binding Usage.WarnPercent}" CriticalLevel="{Binding Usage.CriticalPercent}" />
                </DockPanel>

                <!-- The week, with the model-specific weekly limits as thinner lines -->
                <DockPanel Grid.Column="1" Margin="0,0,20,0" IsVisible="{Binding Usage.ShowWeekChart, FallbackValue=False}">
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,2">
                    <TextBlock Classes="small" FontWeight="SemiBold" Text="This week" />
                    <ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding Usage.WeekLegend}"
                                  IsVisible="{Binding Usage.HasWeekLegend, FallbackValue=False}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ChartLegendItem">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Classes="swatch" Classes.model1="{Binding IsFirstModel}" Classes.model2="{Binding IsSecondModel}" />
                            <TextBlock Classes="small muted" Text="{Binding Label}" />
                            <TextBlock Classes="small" Text="{Binding PercentText}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <controls:UsageDetailChart Name="WeekChart" Axis="Days"
                                             Points="{Binding Usage.WeekPoints}" Projection="{Binding Usage.WeekProjection}" Series="{Binding Usage.WeekModelSeries}"
                                             RangeStart="{Binding Usage.WeekStart}" RangeEnd="{Binding Usage.WeekEnd}" Now="{Binding Usage.Now}"
                                             WarnLevel="{Binding Usage.WarnPercent}" CriticalLevel="{Binding Usage.CriticalPercent}" />
                </DockPanel>

                <!-- The burn rate and the time to the limit -->
                <StackPanel Grid.Column="2" Width="130" Margin="0,0,20,0">
                  <TextBlock Classes="small muted" Text="Burn rate" />
                  <TextBlock Classes="figure" Text="{Binding Usage.BurnRateText, FallbackValue=''}" />
                  <TextBlock Classes="small muted" Text="{Binding Usage.BurnRateNote, FallbackValue=''}" TextWrapping="Wrap" />
                  <TextBlock Classes="small muted" Text="Time to limit" Margin="0,10,0,0" />
                  <TextBlock Classes="figure" Classes.warning="{Binding Usage.IsProjectionWarning, FallbackValue=False}" Text="{Binding Usage.TimeToLimitText, FallbackValue=''}" />
                  <TextBlock Classes="small muted" Classes.warning="{Binding Usage.IsProjectionWarning, FallbackValue=False}" Text="{Binding Usage.TimeToLimitNote, FallbackValue=''}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- The busiest tabs this window, by tokens -->
                <StackPanel Name="BusiestTabs" Grid.Column="3" Width="200" Spacing="6" IsVisible="{Binding Usage.ShowBusiestTabs, FallbackValue=False}">
                  <TextBlock Classes="small" FontWeight="SemiBold" Text="Busiest tabs" />
                  <TextBlock Classes="small muted" Text="No turns yet in this window." TextWrapping="Wrap" IsVisible="{Binding !Usage.HasBusiestTabs, FallbackValue=True}" />
                  <ItemsControl ItemsSource="{Binding Usage.BusiestTabs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:TabBurnRow">
                        <StackPanel Spacing="3" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="small muted" Text="{Binding ShareText}" />
                          </Grid>
                          <ProgressBar Classes="meter" Maximum="1" Height="4" MinHeight="4" Value="{Binding Share}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Button>
          </Grid>
        </Border>

        <!-- Usage credits pay for Claude (DESIGN.md §6, "Usage credits"): no Dismiss, it goes when they stop paying -->
        <Border Name="CreditsNotice" DockPanel.Dock="Top" Classes="statusbanner" IsVisible="{Binding Usage.IsUsingCredits, FallbackValue=False}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
              <Run FontWeight="SemiBold" Text="Using usage credits." />
              <Run Text="{Binding Usage.CreditsNotice, FallbackValue=''}" />
            </TextBlock>
            <Button Grid.Column="1" Classes="flat" Content="Manage on claude.ai" Command="{Binding Usage.OpenCreditsSettingsCommand, FallbackValue={x:Null}}"
                    VerticalAlignment="Center" ToolTip.Tip="Your plan's usage on claude.ai, in your browser: where usage credits are turned off or capped" />
          </Grid>
        </Border>

        <!-- Claude has an incident, or maintenance (DESIGN.md §18, "Service status"), until dismissed or over -->
        <Border Name="ServiceStatusBanner" DockPanel.Dock="Top" Classes="statusbanner" Classes.info="{Binding ServiceStatus.IsInfoBanner}"
                IsVisible="{Binding ServiceStatus.ShowBanner}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
              <Run FontWeight="SemiBold" Text="{Binding ServiceStatus.BannerTitle}" />
              <Run Text="{Binding ServiceStatus.BannerText}" />
            </TextBlock>
            <Button Grid.Column="1" Classes="flat" Content="Status page" Command="{Binding ServiceStatus.OpenBannerLinkCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="flat" Content="Dismiss" Command="{Binding ServiceStatus.DismissBannerCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Claude Code needs a sign-in mid-session (DESIGN.md §11): a banner across all tabs, which stay open -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Account.NeedsSignIn}" Background="{DynamicResource CautionBackgroundBrush}"
                BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
              <Run FontWeight="SemiBold" Text="Claude Code needs you to sign in." />
              <Run Text="Messages you send wait until you have." />
            </TextBlock>
            <Button Grid.Column="1" Classes="accent" Content="Sign in" Command="{Binding Account.BeginSignInCommand}" />
          </Grid>
        </Border>

        <!-- A usage alert, until OS notifications arrive (milestone 7) -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Usage.HasAlert, FallbackValue=False}" Background="{DynamicResource CautionBackgroundBrush}"
                BorderBrush="{DynamicResource CautionBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
              <Run FontWeight="SemiBold" Text="{Binding Usage.Alert.Title, FallbackValue=''}" />
              <Run Text="{Binding Usage.Alert.Message, FallbackValue=''}" />
            </TextBlock>
            <Button Grid.Column="1" Classes="flat" Content="Dismiss" Command="{Binding Usage.DismissAlertCommand}" />
          </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" Background="{DynamicResource PageBackgroundBrush}" />
      </DockPanel>

      <!-- The sign-in dialog the banner opens (DESIGN.md §11) -->
      <Border Classes="overlay" IsVisible="{Binding Account.HasSignIn}">
        <ContentControl Content="{Binding Account.SignIn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Signing out asks first, because every tab stops working -->
      <Border Classes="overlay" IsVisible="{Binding Account.HasSignOutConfirmation}">
        <Border Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" DataContext="{Binding Account.SignOutConfirmation}">
          <StackPanel Spacing="14" x:DataType="vm:ConfirmationViewModel">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel" Command="{Binding CancelCommand}" />
              <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </LayoutTransformControl>
</Window>

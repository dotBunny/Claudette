<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Claudette.App.Controls"
        xmlns:diffs="using:Claudette.App.Diffs"
        xmlns:views="using:Claudette.App.Views"
        x:Class="Claudette.App.Views.DiffWindow"
        x:DataType="diffs:DiffWindowViewModel"
        Title="{Binding Title, StringFormat='{}{0} — diff'}"
        Width="1000" Height="720" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">

  <!-- DESIGN.md §8: the built-in diff view -->
  <DockPanel>
    <!-- The window's title bar, while it draws its own (DESIGN.md §3, "Window frame"), naming what it shows -->
    <controls:TitleBar DockPanel.Dock="Top" Padding="14,10" ShowsTitle="False">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding Stats}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <ToggleButton Content="Side by side" IsChecked="{Binding IsSideBySide}" />
          <ToggleButton Content="Whole file" IsChecked="{Binding ShowWholeFile}" />
          <ToggleButton Content="Wrap lines" IsChecked="{Binding WordWrap}" ToolTip.Tip="Wrap long lines at the window's width, rather than scrolling sideways" />
          <!-- DESIGN.md §8, "This session's changes": the file changed since the session's last change to it -->
          <ToggleButton Content="With later changes" IsChecked="{Binding ShowLaterChanges}" IsVisible="{Binding HasLaterChanges}"
                        ToolTip.Tip="The file has changed since this session's last change to it. Show it as it is now, with those changes too." />
          <Button Content="Open in diff tool" Command="{Binding OpenInDiffToolCommand}" IsVisible="{Binding CanOpenInDiffTool}" />
          <Button Content="Open" Command="{Binding OpenInEditorCommand}" ToolTip.Tip="As Settings → Files and diffs → Open in the diff window says: the file in Claudette's editor or the OS's app, or the changes in your diff tool" />
          <!-- DESIGN.md §8, "Reverting": asks first, in place -->
          <Button Content="Revert file" Command="{Binding RevertConfirmation.AskCommand}" ToolTip.Tip="{Binding RevertFileTip}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="CanRevert" />
                <Binding Path="!RevertConfirmation.IsOpen" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding RevertConfirmation.IsOpen}">
            <TextBlock Classes="small" Text="Put the whole file back?" VerticalAlignment="Center" />
            <Button Classes="accent" Content="Revert" Command="{Binding RevertConfirmation.ConfirmCommand}" />
            <Button Content="Cancel" Command="{Binding RevertConfirmation.CancelCommand}" />
          </StackPanel>
          <Button Content="…" ToolTip.Tip="More" AutomationProperties.Name="More actions">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Open in the OS's app" Command="{Binding OpenInSystemCommand}" IsVisible="{Binding CanOpenInSystem}" />
                <MenuItem Header="Reveal in file manager" Command="{Binding RevealCommand}" />
                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" />
                <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- DESIGN.md §8, "Reviewed": ticks the file in Changed files and closes the view -->
          <Button x:Name="ReviewedButton" Classes="accent" Command="{Binding MarkReviewedCommand}" IsVisible="{Binding CanMarkReviewed}"
                  ToolTip.Tip="Mark this file as reviewed and close the diff. It stays reviewed until Claude changes it again.">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconCheck}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"
                    VerticalAlignment="Center" IsVisible="{Binding IsReviewed}" />
              <TextBlock Text="Reviewed" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
          <TextBlock Classes="muted small" TextTrimming="PathSegmentEllipsis">
            <Run Text="{Binding DisplayPath}" />
            <Run Text="·" />
            <Run Text="{Binding BeforeLabel}" />
          </TextBlock>
          <!-- DESIGN.md §8, "What the lines don't show": line endings, a byte order mark, the newline at the end, whitespace -->
          <TextBlock Classes="muted small" Text="{Binding Note}" TextWrapping="Wrap"
                     IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Grid>
    </controls:TitleBar>

    <views:DiffLines />
  </DockPanel>
</Window>

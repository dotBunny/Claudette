<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Claudette.App.ViewModels.Settings"
             xmlns:c="using:Claudette.App.Controls"
             x:Class="Claudette.App.Views.Settings.UsagePageView" ClipToBounds="False"
             x:DataType="settings:UsagePage">
  <!-- Usage (DESIGN.md §6) -->
  <StackPanel Spacing="32">
    <c:SettingsSection Key="warnings">
      <c:SettingRow Key="usage.warnPercent">
        <NumericUpDown Minimum="1" Maximum="100" Increment="5" FormatString="0" Value="{Binding WarnPercent}" />
      </c:SettingRow>
      <c:SettingRow Key="usage.criticalPercent">
        <NumericUpDown Minimum="1" Maximum="100" Increment="5" FormatString="0" Value="{Binding CriticalPercent}" />
      </c:SettingRow>
      <c:SettingRow Key="usage.burnRateWindowMinutes">
        <NumericUpDown Minimum="5" Maximum="300" Increment="5" FormatString="0" Value="{Binding BurnRateWindowMinutes}" />
      </c:SettingRow>
    </c:SettingsSection>

    <c:SettingsSection Key="header">
      <c:SettingRow Key="usage.compactHeader">
        <ToggleSwitch IsChecked="{Binding CompactHeader}" />
      </c:SettingRow>
      <c:SettingRow Key="usage.showModelMeters">
        <ToggleSwitch IsChecked="{Binding ShowModelMeters}" />
        <c:SettingRow.Details>
          <c:SettingRow Key="usage.useUsageCommandFallback" IsEnabled="{Binding ShowModelMeters}">
            <ToggleSwitch IsChecked="{Binding UseUsageCommandFallback}" />
          </c:SettingRow>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="state.detailedUsageHeader">
        <ToggleSwitch IsChecked="{Binding DetailedUsageHeader}" />
      </c:SettingRow>
    </c:SettingsSection>

    <!-- DESIGN.md §6, "Usage history" and "Sharing across machines" -->
    <c:SettingsSection Key="history">
      <c:SettingRow Key="usage.keepHistory">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding HistoryRetentionChoices}" SelectedItem="{Binding KeepUsageHistory}" MinWidth="160" AutomationProperties.Name="Keep usage history" />
          <Button Content="Clear…" Command="{Binding ClearUsageHistoryCommand}" ToolTip.Tip="Clear usage history" AutomationProperties.Name="Clear usage history" />
        </StackPanel>
        <c:SettingRow.Details>
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="ClearUsageConfirmation.IsOpen" />
                <Binding Path="UsageClearedText" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <Border Classes="settingsnote" IsVisible="{Binding ClearUsageConfirmation.IsOpen}">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Clear all usage history?" />
                <TextBlock TextWrapping="Wrap" Text="This deletes every stored usage sample and per-turn token record. The header fills in again at the next update from Claude Code." />
                <CheckBox Content="Also reset per-tab token totals" IsChecked="{Binding AlsoResetTabTotals}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="Clear" Command="{Binding ClearUsageConfirmation.ConfirmCommand}" />
                  <Button Content="Cancel" Command="{Binding ClearUsageConfirmation.CancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted small" Text="{Binding UsageClearedText}" IsVisible="{Binding UsageClearedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
      <c:SettingRow Key="usage.shareThroughLibrary">
        <ToggleSwitch IsChecked="{Binding ShareUsageThroughLibrary}" />
      </c:SettingRow>
      <c:SettingRow Key="usage.clearEverywhere" Description="Here and in the session library; each machine that shares clears its own when it next checks.">
        <Button Content="Clear on every machine…" Command="{Binding ClearEverywhereCommand}" />
        <c:SettingRow.Details>
          <StackPanel Spacing="8">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Path="ClearEverywhereConfirmation.IsOpen" />
                <Binding Path="ClearedEverywhereText" Converter="{x:Static ObjectConverters.IsNotNull}" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <Border Classes="settingsnote" IsVisible="{Binding ClearEverywhereConfirmation.IsOpen}">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Clear usage history on every machine?" />
                <TextBlock TextWrapping="Wrap"
                           Text="This clears this machine's usage history and the usage shared in the session library. Every machine that shares its usage clears its own history up to now the next time it checks: within a minute if it's running, or when it starts." />
                <CheckBox Content="Also reset per-tab token totals on every machine" IsChecked="{Binding AlsoResetTabTotalsEverywhere}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="Clear everywhere" Command="{Binding ClearEverywhereConfirmation.ConfirmCommand}" />
                  <Button Content="Cancel" Command="{Binding ClearEverywhereConfirmation.CancelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding ClearedEverywhereText}"
                       IsVisible="{Binding ClearedEverywhereText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </c:SettingRow.Details>
      </c:SettingRow>
    </c:SettingsSection>
  </StackPanel>
</UserControl>
